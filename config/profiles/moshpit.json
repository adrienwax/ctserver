  "everyPage": {
    "keys": {},
    "buttons": {
      "home": {
        "do": {
          "main": true
        }
      },
      "save": {
        "do": {
          "keys": "ctrl+s"
        }
      },
      "undo": {
        "do": {
          "moshpit": {
            "verb": "command",
            "command": "edit.undo"
          }
        },
        "hold": {
          "moshpit": {
            "verb": "command",
            "command": "edit.redo"
          }
        }
      },
      "a": {
        "do": {
          "moshpit": {
            "verb": "command",
            "command": "transport.play"
          }
        }
      },
      "b": {
        "do": {
          "moshpit": {
            "verb": "command",
            "command": "transport.stop"
          }
        }
      },
      "c": {
        "do": {
          "moshpit": {
            "verb": "command",
            "command": "transport.prevFrame"
          }
        }
      },
      "d": {
        "do": {
          "moshpit": {
            "verb": "command",
            "command": "transport.nextFrame"
          }
        }
      }
    },
    "wheel": {
      "turn": {
        "moshpit": {
          "verb": "step",
          "commands": [
            "transport.prevFrame",
            "transport.nextFrame"
          ]
        }
      },
      "tap": {
        "moshpit": {
          "verb": "command",
          "command": "transport.loop"
        }
      }
    }
