{
  "_help": "Moshpit control through its local authenticated endpoint. Home returns to the dashboard. Pages follow IN, MOSH FX, MOSH EDIT and OUT. A plays, B pauses, C/D step backward/forward. KBD gives fine adjustments; Fn gives coarse adjustments. Edit mappings in MAP; changes autosave.",
  "name": "MOSHPIT",
  "color": "coral",
  "app": "moshpit",
  "followWorkspace": true,
  "stripGestures": false,
  "pages": [
    {
      "name": "IN",
      "enter": {
        "moshpit": {
          "verb": "command",
          "command": "workspace.browse"
        }
      },
      "keys": {
        "0": {
          "label": "ALL FRAMES",
          "icon": "source",
          "sub": "RANGE",
          "do": {
            "moshpit": {
              "verb": "command",
              "command": "source.selectAll"
            }
          },
          "color": "sky"
        },
        "2": {
          "label": "CLIP -",
          "icon": "back",
          "sub": "IN",
          "do": {
            "moshpit": {
              "verb": "command",
              "command": "clip.prev"
            }
          },
          "color": "dust"
        },
        "3": {
          "label": "CLIP +",
          "icon": "forward",
          "sub": "IN",
          "do": {
            "moshpit": {
              "verb": "command",
              "command": "clip.next"
            }
          },
          "color": "dust"
        },
        "4": {
          "label": "ADD BLOCK",
          "icon": "add",
          "sub": "MARKED RANGE",
          "do": {
            "moshpit": {
              "verb": "command",
              "command": "source.addBlock"
            }
          },
          "color": "cyan"
        },
        "8": {
          "label": "MARK IN",
          "icon": "mark-in",
          "sub": "HEAD",
          "do": {
            "moshpit": {
              "verb": "command",
              "command": "mark.in"
            }
          },
          "color": "sand"
        },
        "9": {
          "label": "MARK OUT",
          "icon": "mark-out",
          "sub": "HEAD",
          "do": {
            "moshpit": {
              "verb": "command",
              "command": "mark.out"
            }
          },
          "color": "sand"
        },
        "10": {
          "label": "SEND A",
          "icon": "import",
          "sub": "MARKED RANGE",
          "do": {
            "moshpit": {
              "verb": "command",
              "command": "source.sendA"
            }
          },
          "color": "cyan"
        },
        "11": {
          "label": "SEND B",
          "icon": "import",
          "sub": "MARKED RANGE",
          "do": {
            "moshpit": {
              "verb": "command",
              "command": "source.sendB"
            }
          },
          "color": "cyan"
        }
      },
      "dials": {
        "TL": {
          "name": "IN",
          "turn": {
            "moshpit": {
              "verb": "step",
              "commands": [
                "mark.in.nudgeBack",
                "mark.in.nudgeForward"
              ]
            }
          },
          "press": {
            "moshpit": {
              "verb": "command",
              "command": "mark.in"
            }
          }
        },
        "CL": {
          "name": "OUT",
          "turn": {
            "moshpit": {
              "verb": "step",
              "commands": [
                "mark.out.nudgeBack",
                "mark.out.nudgeForward"
              ]
            }
          },
          "press": {
            "moshpit": {
              "verb": "command",
              "command": "mark.out"
            }
          }
        },
        "BL": {
          "name": "TRANSPOSE",
          "turn": {
            "moshpit": {
              "verb": "step",
              "commands": [
                "mark.range.nudgeBack",
                "mark.range.nudgeForward"
              ]
            }
          }
        },
        "TR": {
          "name": "CLIP",
          "turn": {
            "moshpit": {
              "verb": "step",
              "commands": [
                "clip.prev",
                "clip.next"
              ]
            }
          }
        },
        "CR": {
          "name": "FOLDER",
          "turn": {
            "moshpit": {
              "verb": "step",
              "commands": [
                "folder.prev",
                "folder.next"
              ]
            }
          }
        },
        "BR": {
          "name": "ZOOM",
          "turn": {
            "moshpit": {
              "verb": "step",
              "commands": [
                "source.zoomOut",
                "source.zoomIn"
              ]
            }
          },
          "press": {
            "moshpit": {
              "verb": "command",
              "command": "source.zoomFit"
            }
          }
        }
      },
      "buttons": {
        "enter": {
          "do": {
            "moshpit": {
              "verb": "command",
              "command": "source.sendA"
            }
          }
        }
      }
    },
