          "do": {
            "keys": "ctrl+1"
          }
        },
        "2": {
          "label": "CLIPS",
          "icon": "clip",
          "sub": "",
          "color": "magenta",
          "do": {
            "keys": "ctrl+2"
          }
        },
        "3": {
          "label": "SOURCE",
          "icon": "source",
          "sub": "",
          "color": "magenta",
          "do": {
            "keys": "ctrl+3"
          }
