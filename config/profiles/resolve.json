{
  "name": "RESOLVE",
  "app": "resolve",
  "color": "magenta",
  "followFocus": false,
  "followWorkspace": false,
  "_help": "Resolve 21, owner named shortcut preset render in placc. Six workspace pages; relative shortcut actions have no absolute gauge or guessed toggle state. A/B/C/D play/stop/back/forward; KBD/FN remain fine/coarse modifiers. Page buttons switch Resolve; if changing workspace in Resolve, select matching CT page. No scripting setup is required. HOVER SCROLL: point at the intended pane first; clockwise scrolls down. It is a Windows pointer-wheel action, not a guarantee of scrolling the focused app.",
  "everyPage": {
    "buttons": {
      "home": {
        "do": {
          "main": true
        }
      },
      "save": {
        "do": {
          "keys": "ctrl+s"
        }
      },
      "undo": {
        "do": {
          "keys": "ctrl+z"
        },
        "redo": {
          "keys": "ctrl+shift+z"
        }
      },
      "a": {
        "do": {
          "keys": "l"
        }
      },
      "b": {
        "do": {
          "keys": "k"
        }
      },
      "c": {
        "do": {
          "keys": "left"
        }
      },
      "d": {
        "do": {
          "keys": "right"
        }
      }
    },
    "wheel": {
      "turn": {
        "keys": [
          "left",
          "right"
        ]
      },
      "tap": {
        "keys": "space"
      }
    }
  },
  "pages": [
