        "7": {
          "label": "SUBCLIP",
          "icon": "slice",
          "sub": "",
          "color": "magenta",
          "do": {
            "keys": "alt+b"
          }
        },
        "8": {
          "label": "MARKER",
          "icon": "add",
          "sub": "",
          "color": "magenta",
          "do": {
            "keys": "ctrl+m"
          }
