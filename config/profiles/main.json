          "icon": "node",
          "color": "cyan",
          "do": {
            "home": "setup"
          }
        },
        "2": {
          "label": "PROJECT",
          "icon": "clip",
          "color": "cyan",
          "do": {
            "home": "projects"
          }
        },
        "3": {
          "label": "FILES",
          "icon": "folder",
          "color": "sand",
          "do": {
            "launch": "explorer.exe"
          }
        },
        "4": {
          "label": "PROFILES",
          "icon": "layers",
          "color": "cyan",
          "do": {
