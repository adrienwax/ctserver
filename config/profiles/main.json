          "do": {
            "home": "guides"
          }
        },
        "7": {
          "label": "SETUP",
          "icon": "settings",
          "color": "sand",
          "do": {
            "home": "setup"
          }
        },
        "8": {
          "label": "DEVICE",
          "icon": "desktop",
          "color": "sand",
          "do": {
            "home": "device"
          }
        },
        "9": {
          "label": "APPS",
          "icon": "layers",
          "color": "cyan",
          "do": {
            "home": "apps"
          }
        },
        "10": {
          "label": "WINDOWS",
          "icon": "desktop",
          "color": "sage",
          "do": {
            "app": "windows"
          }
        },
        "11": {
          "label": "SPOTIFY",
          "icon": "volume",
          "color": "green",
          "sub": "",
          "do": {
            "app": "spotify"
          }
        }
      },
      "dials": {
        "TL": {
          "name": "VOLUME",
          "turn": {
            "volume": 1
          },
          "press": {
            "media": "mute"
          }
        },
        "TR": {
          "name": "SCROLL",
          "turn": {
            "scroll": -1
          }
        },
        "CL": {
          "name": "APPS",
          "turn": {
            "home": "browse-apps"
          },
          "press": {
            "home": "pick-apps"
          }
        },
        "BL": {
          "name": "PROFILES",
          "turn": {
            "home": "browse-profiles"
          },
          "press": {
            "home": "pick-profiles"
          }
        },
        "CR": {
          "name": "PAGES",
          "turn": {
            "home": "browse-pages"
          },
          "press": {
            "home": "pick-pages"
          }
        },
        "BR": {
          "name": "PROJECTS",
          "turn": {
            "home": "browse-projects"
          },
          "press": {
            "home": "pick-projects"
          }
        }
      },
      "buttons": {
        "home": {
          "do": {
            "main": true
          }
        }
      }
